---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout metadata={{ title: "B2B AI Assessment & ROI Kalkulator — AstroWind" }}>
  <section class="px-4 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl">
      
      <div class="text-center mb-12">
        <span class="inline-flex items-center rounded-md bg-blue-50 dark:bg-blue-900/20 px-3 py-1.5 text-sm font-medium text-blue-700 dark:text-blue-300 ring-1 ring-inset ring-blue-700/10 dark:ring-blue-300/10">
          Celovita B2B AI Analiza
        </span>
        <h1 class="mt-4 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
          Pravi ROI: Prihodki, Stroški in Odgovornost
        </h1>
        <p class="mt-4 text-lg leading-8 text-gray-600 dark:text-slate-400">
          Avtomatizacija ni le prihranek časa. Zmanjšuje napake, nadomešča draga orodja, krije bolniške in povečuje prihodke iz starih stikov ter referalov.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- LEVA STRAN: VPRASALNIK -->
        <div class="lg:col-span-2 bg-white dark:bg-slate-800 rounded-2xl shadow-xl border border-slate-100 dark:border-slate-700 p-8 sm:p-10">
          
          <div class="mb-8">
            <div class="flex justify-between mb-2 text-xs font-medium text-gray-500 dark:text-slate-400">
              <span id="step-text">Korak 1 od 6</span>
              <span id="step-percent">16%</span>
            </div>
            <div class="w-full bg-gray-200 dark:bg-slate-700 rounded-full h-2.5">
              <div id="progress-bar" class="bg-blue-600 h-2.5 rounded-full transition-all duration-500" style="width: 16%"></div>
            </div>
          </div>

          <form id="multi-step-form" class="space-y-6">
            <input type="hidden" name="subject" value="B2B Celovita AI Analiza" />

            <!-- KORAK 1 -->
            <div class="form-step" data-step="1">
              <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6">1. Novi Poslovni Stiki</h2>
              <div class="space-y-6">
                <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-2">
                  <div>
                    <label for="leads" class="block text-sm font-medium text-gray-900 dark:text-slate-200">Koliko novih povpraševanj prejmete mesečno? <span class="text-red-500">*</span></label>
                    <input type="number" id="leads" name="Stevilo_Leadov" value="100" min="1" required class="roi-input mt-2 block w-full rounded-md border-0 py-2.5 text-gray-900 dark:bg-slate-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-slate-600 focus:ring-2 focus:ring-inset focus:ring-blue-600" />
                  </div>
                  <div>
                    <label for="response_time" class="block text-sm font-medium text-gray-900 dark:text-slate-200">Koliko ur traja odgovor na povpraševanje? <span class="text-red-500">*</span></label>
                    <input type="number" id="response_time" name="Cas_Odgovora" value="4" min="0" required class="roi-input mt-2 block w-full rounded-md border-0 py-2.5 text-gray-900 dark:bg-slate-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-slate-600 focus:ring-2 focus:ring-inset focus:ring-blue-600" />
                  </div>
                </div>
                <div>
                  <label for="value" class="block text-sm font-medium text-gray-900 dark:text-slate-200">Povprečna vrednost vaše storitve/produkta (€)? <span class="text-red-500">*</span></label>
                  <input type="number" id="value" name="Povprecna_Vrednost" value="500" min="1" required class="roi-input mt-2 block w-full rounded-md border-0 py-2.5 text-gray-900 dark:bg-slate-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-slate-600 focus:ring-2 focus:ring-inset focus:ring-blue-600" />
                </div>
                <div>
                  <label for="existing_customers" class="block text-sm font-medium text-gray-900 dark:text-slate-200">Koliko AKTIVNIH strank imate trenutno? <span class="text-red-500">*</span></label>
                  <input type="number" id="existing_customers" name="Stevilo_Strank" value="50" min="0" required class="roi-input mt-2 block w-full rounded-md border-0 py-2.5 text-gray-900 dark:bg-slate-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-slate-600 focus:ring-2 focus:ring-inset focus:ring-blue-600" />
                  <p class="mt-1 text-xs text-gray-500">* Uporablja se za izračun prihodka iz referalov in starih stikov.</p>
                </div>
              </div>
              <div class="mt-8 flex justify-end">
                <button type="button" class="next-btn btn-primary">Naprej <Icon name="tabler:arrow-right" class="w-4 h-4" /></button>
              </div>
            </div>

            <!-- KORAK 2 -->
            <div class="form-step hidden" data-step="2">
              <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6">2. Trenutni Stroški in Operativa</h2>
              <div class="space-y-6">
                <div>
                  <label for="tool_cost" class="block text-sm font-medium text-gray-900 dark:text-slate-200">Koliko mesečno porabite za SaaS orodja (CRM, Klicne centere, Mailchimp...)? <span class="text-red-500">*</span></label>
                  <input type="number" id="tool_cost" name="Stroski_Orodij" value="300" min="0" required class="roi-input mt-2 block w-full rounded-md border-0 py-2.5 text-gray-900 dark:bg-slate-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-slate-600 focus:ring-2 focus:ring-inset focus:ring-blue-600" />
                </div>
                <div>
                  <label for="manual_work" class="block text-sm font-medium text-gray-900 dark:text-slate-200">Koliko ur dnevno porabite za ročno vpisovanje podatkov? <span class="text-red-500">*</span></label>
                  <input type="number" id="manual_work" name="Rocno_Vpisovanje" value="2" min="0" required class="roi-input mt-2 block w-full rounded-md border-0 py-2.5 text-gray-900 dark:bg-slate-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-slate-600 focus:ring-2 focus:ring-inset focus:ring-blue-600" />
                </div>
                <div>
                  <label for="crm" class="block text-sm font-medium text-gray-900 dark:text-slate-200">Kako trenutno upravljate s stiki? <span class="text-red-500">*</span></label>
                  <select id="crm" name="Trenutni_CRM" required class="mt-2 block w-full rounded-md border-0 py-3 pl-3 pr-10 text-gray-900 dark:bg-slate-900 dark:text-white ring-1 ring-inset ring-gray-300 dark:ring-slate-600 focus:ring-2 focus:ring-inset focus:ring-blue-600 appearance-none">
                    <option value="" disabled selected>-- Izberite --</option>
                    <option value="Excel/Papir">Excel ali papir (največ napak)</option>
                    <option value="Brez CRM-a">Še nimamo urejenega CRM-a</option>
                    <option value="EspoCRM">EspoCRM</option>
                    <option value="Drugi SaaS">Drugi SaaS</option>
                  </select>
                </div>
              </div>
              <div class="mt-8 flex justify-between">
                <button type="button" class="prev-btn btn-secondary"><Icon name="tabler:arrow-left" class="w-4 h-4" /> Nazaj</button>
                <button type="button" class="next-btn btn-primary">Naprej <Icon name="tabler:arrow-right" class="w-4 h-4" /></button>
              </div>
            </div>

            <!-- KORAK 3 -->
            <div class="form-step hidden" data-step="3">
              <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6">3. Telefonija in Komunikacija</h2>
              <div class="space-y-6">
                <div>
                  <label for="voip" class="block text-sm font-medium text-gray-900 dark:text-slate-200">Ali imate urejeno lastno telefonsko centralo (FusionPBX)? <span class="text-red-500">*</span></label>
                  <select id="voip" name="VoIP_Centrala" required class="mt-2 block w-full rounded-md border-0 py-3 pl-3 pr-10 text-gray-900 dark:bg-slate-900 dark:text-white ring-1 ring-inset ring-gray-300 dark:ring-slate-600 focus:ring-2 focus:ring-inset focus:ring-blue-600 appearance-none">
                    <option value="" disabled selected>-- Izberite --</option>
                    <option value="Da, lastno">Da, upravljamo lastno centralo</option>
                    <option value="Ne, outsourced">Ne, imamo zunanjega ponudnika</option>
                    <option value="Samo mobilni">Uporabljamo samo mobilne številke</option>
                  </select>
                </div>
                <div>
                  <label for="missed_calls" class="block text-sm font-medium text-gray-900 dark:text-slate-200">Kaj se zgodi, ko zgrešite klic? <span class="text-red-500">*</span></label>
                  <select id="missed_calls" name="Zgreseni_Klici" required class="mt-2 block w-full rounded-md border-0 py-3 pl-3 pr-10 text-gray-900 dark:bg-slate-900 dark:text-white ring-1 ring-inset ring-gray-300 dark:ring-slate-600 focus:ring-2 focus:ring-inset focus:ring-blue-600 appearance-none">
                    <option value="" disabled selected>-- Izberite --</option>
                    <option value="Voicemail">Pusti voicemail (pogosto izgubljeno)</option>
                    <option value="Nazaj">Operater pokliče nazaj</option>
                    <option value="AI Transkripcija">Že imamo AI obvestila</option>
                  </select>
                </div>
                <div>
                  <label for="nurturing" class="block text-sm font-medium text-gray-900 dark:text-slate-200">Ali imate avtomatske nurturing sekvence za stranke?</label>
                  <select id="nurturing" name="Nurturing_Sekvence" class="mt-2 block w-full rounded-md border-0 py-3 pl-3 pr-10 text-gray-900 dark:bg-slate-900 dark:text-white ring-1 ring-inset ring-gray-300 dark:ring-slate-600 focus:ring-2 focus:ring-inset focus:ring-blue-600 appearance-none">
                    <option value="Ne" selected>Ne, delamo ročno</option>
                    <option value="Delno">Delno, a nepovezano</option>
                    <option value="Da">Da, vse je avtomatizirano</option>
                  </select>
                </div>
              </div>
              <div class="mt-8 flex justify-between">
                <button type="button" class="prev-btn btn-secondary"><Icon name="tabler:arrow-left" class="w-4 h-4" /> Nazaj</button>
                <button type="button" class="next-btn btn-primary">Naprej <Icon name="tabler:arrow-right" class="w-4 h-4" /></button>
              </div>
            </div>

            <!-- KORAK 4 -->
            <div class="form-step hidden" data-step="4">
              <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6">4. Infrastruktura in Varnost</h2>
              <div class="space-y-6">
                <div>
                  <label for="hosting" class="block text-sm font-medium text-gray-900 dark:text-slate-200">Kje gostujete svojo infrastrukturo? <span class="text-red-500">*</span></label>
                  <select id="hosting" name="Hosting" required class="mt-2 block w-full rounded-md border-0 py-3 pl-3 pr-10 text-gray-900 dark:bg-slate-900 dark:text-white ring-1 ring-inset ring-gray-300 dark:ring-slate-600 focus:ring-2 focus:ring-inset focus:ring-blue-600 appearance-none">
                    <option value="" disabled selected>-- Izberite --</option>
                    <option value="Lokalni server">Lokalni server v pisarni</option>
                    <option value="Hetzner/Cloud">Hetzner / Cloudflare / VPS</option>
                    <option value="Ne vemo">Ne vemo točno / shared hosting</option>
                  </select>
                </div>
                <div>
                  <label for="backup" class="block text-sm font-medium text-gray-900 dark:text-slate-200">Ali imate dokumentirano proceduro za backup in restore? <span class="text-red-500">*</span></label>
                  <select id="backup" name="Backup_Procedura" required class="mt-2 block w-full rounded-md border-0 py-3 pl-3 pr-10 text-gray-900 dark:bg-slate-900 dark:text-white ring-1 ring-inset ring-gray-300 dark:ring-slate-600 focus:ring-2 focus:ring-inset focus:ring-blue-600 appearance-none">
                    <option value="" disabled selected>-- Izberite --</option>
                    <option value="Da">Da, redno testiramo restore</option>
                    <option value="Samodejno">Imamo samodejne backupe, a jih ne preverjamo</option>
                    <option value="Ne">Ne, to je naše šibko mesto</option>
                  </select>
                </div>
                <div>
                  <label for="security" class="block text-sm font-medium text-gray-900 dark:text-slate-200">Ali imate urejen security baseline (dostopi, ključi, 2FA)? <span class="text-red-500">*</span></label>
                  <select id="security" name="Security_Baseline" required class="mt-2 block w-full rounded-md border-0 py-3 pl-3 pr-10 text-gray-900 dark:bg-slate-900 dark:text-white ring-1 ring-inset ring-gray-300 dark:ring-slate-600 focus:ring-2 focus:ring-inset focus:ring-blue-600 appearance-none">
                    <option value="" disabled selected>-- Izberite --</option>
                    <option value="Da">Da, strogo kontrolirano</option>
                    <option value="Delno">Delno, 2FA imamo samo na glavnih računih</option>
                    <option value="Ne">Ne, dostopi so ad hoc</option>
                  </select>
                </div>
              </div>
              <div class="mt-8 flex justify-between">
                <button type="button" class="prev-btn btn-secondary"><Icon name="tabler:arrow-left" class="w-4 h-4" /> Nazaj</button>
                <button type="button" class="next-btn btn-primary">Naprej <Icon name="tabler:arrow-right" class="w-4 h-4" /></button>
              </div>
            </div>

            <!-- KORAK 5 -->
            <div class="form-step hidden" data-step="5">
              <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6">5. Pogodbe, SLA in GDPR</h2>
              <div class="space-y-6">
                <div>
                  <label for="dpa" class="block text-sm font-medium text-gray-900 dark:text-slate-200">Ali imate urejene pogodbe o obdelavi podatkov (DPA)? <span class="text-red-500">*</span></label>
                  <select id="dpa" name="DPA_Pogodbe" required class="mt-2 block w-full rounded-md border-0 py-3 pl-3 pr-10 text-gray-900 dark:bg-slate-900 dark:text-white ring-1 ring-inset ring-gray-300 dark:ring-slate-600 focus:ring-2 focus:ring-inset focus:ring-blue-600 appearance-none">
                    <option value="" disabled selected>-- Izberite --</option>
                    <option value="Da">Da, za vse ponudnike</option>
                    <option value="Delno">Delno, nismo povsem pokriti</option>
                    <option value="Ne">Ne, to moramo še urediti</option>
                  </select>
                </div>
                <div>
                  <label for="retention" class="block text-sm font-medium text-gray-900 dark:text-slate-200">Ali imate jasne retention roke za posnetke in loge? <span class="text-red-500">*</span></label>
                  <select id="retention" name="Retention_Roke" required class="mt-2 block w-full rounded-md border-0 py-3 pl-3 pr-10 text-gray-900 dark:bg-slate-900 dark:text-white ring-1 ring-inset ring-gray-300 dark:ring-slate-600 focus:ring-2 focus:ring-inset focus:ring-blue-600 appearance-none">
                    <option value="" disabled selected>-- Izberite --</option>
                    <option value="Da">Da, imamo politiko hrambe</option>
                    <option value="Ne">Ne, hranimo vse neskončno dolgo</option>
                  </select>
                </div>
                <div>
                  <label for="exit_process" class="block text-sm font-medium text-gray-900 dark:text-slate-200">Ali imate definiran "exit" proces (izvoz/predaja ob prekinitvi)?</label>
                  <select id="exit_process" name="Exit_Proces" class="mt-2 block w-full rounded-md border-0 py-3 pl-3 pr-10 text-gray-900 dark:bg-slate-900 dark:text-white ring-1 ring-inset ring-gray-300 dark:ring-slate-600 focus:ring-2 focus:ring-inset focus:ring-blue-600 appearance-none">
                    <option value="Ne" selected>Ne, nismo razmišljali o tem</option>
                    <option value="Da">Da, pogodbeno je definirano</option>
                  </select>
                </div>
                <div>
                  <label for="sla" class="block text-sm font-medium text-gray-900 dark:text-slate-200">Ali imate pogodbeno določen SLA in incidentni proces? <span class="text-red-500">*</span></label>
                  <select id="sla" name="SLA_Incident" required class="mt-2 block w-full rounded-md border-0 py-3 pl-3 pr-10 text-gray-900 dark:bg-slate-900 dark:text-white ring-1 ring-inset ring-gray-300 dark:ring-slate-600 focus:ring-2 focus:ring-inset focus:ring-blue-600 appearance-none">
                    <option value="" disabled selected>-- Izberite --</option>
                    <option value="Jasen SLA">Da, imamo jasen SLA</option>
                    <option value="Ad hoc">Rešujemo ad hoc</option>
                    <option value="Brez">Brez SLA</option>
                  </select>
                </div>
              </div>
              <div class="mt-8 flex justify-between">
                <button type="button" class="prev-btn btn-secondary"><Icon name="tabler:arrow-left" class="w-4 h-4" /> Nazaj</button>
                <button type="button" class="next-btn btn-primary">Naprej <Icon name="tabler:arrow-right" class="w-4 h-4" /></button>
              </div>
            </div>

            <!-- KORAK 6 -->
            <div class="form-step hidden" data-step="6">
              <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6">6. Prejmite PDF analizo</h2>
              <p class="text-sm text-gray-500 dark:text-slate-400 mb-6">Na podlagi vaših odgovorov vam bomo na e-mail samodejno poslali PDF s celovitim izračunom prihrankov, povečanih prihodkov in predlogom naslednjih korakov.</p>
              
              <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-2">
                <div>
                  <label for="first-name" class="block text-sm font-medium text-gray-900 dark:text-slate-200">Ime in priimek <span class="text-red-500">*</span></label>
                  <input type="text" id="first-name" name="Ime_in_priimek" required class="mt-2 block w-full rounded-md border-0 py-2.5 text-gray-900 dark:bg-slate-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-slate-600 focus:ring-2 focus:ring-inset focus:ring-blue-600" placeholder="Janez Novak" />
                </div>
                <div>
                  <label for="company" class="block text-sm font-medium text-gray-900 dark:text-slate-200">Podjetje</label>
                  <input type="text" id="company" name="Podjetje" class="mt-2 block w-full rounded-md border-0 py-2.5 text-gray-900 dark:bg-slate-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-slate-600 focus:ring-2 focus:ring-inset focus:ring-blue-600" placeholder="Nova Oprema d.o.o." />
                </div>
              </div>
              <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-2 mt-6">
                <div>
                  <label for="email" class="block text-sm font-medium text-gray-900 dark:text-slate-200">E-pošta <span class="text-red-500">*</span></label>
                  <input type="email" id="email" name="E-posta" required class="mt-2 block w-full rounded-md border-0 py-2.5 text-gray-900 dark:bg-slate-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-slate-600 focus:ring-2 focus:ring-inset focus:ring-blue-600" placeholder="janez@podjetje.si" />
                </div>
                <div>
                  <label for="phone" class="block text-sm font-medium text-gray-900 dark:text-slate-200">Telefonska številka</label>
                  <input type="tel" id="phone" name="Telefon" class="mt-2 block w-full rounded-md border-0 py-2.5 text-gray-900 dark:bg-slate-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-slate-600 focus:ring-2 focus:ring-inset focus:ring-blue-600" placeholder="+386 40 123 456" />
                </div>
              </div>

              <div class="mt-8 flex justify-between">
                <button type="button" class="prev-btn btn-secondary"><Icon name="tabler:arrow-left" class="w-4 h-4" /> Nazaj</button>
                <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-md bg-green-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-green-500 transition-colors">Generiraj PDF poročilo <Icon name="tabler:check" class="w-4 h-4" /></button>
              </div>
            </div>

          </form>
        </div>

        <!-- DESNA STRAN: CELI ROI KALKULATOR (Sticky) -->
        <div class="lg:col-span-1">
          <div class="bg-slate-900 dark:bg-slate-900 rounded-2xl shadow-xl border border-slate-800 p-6 text-white sticky top-8 h-fit">
            <h2 class="text-xl font-bold mb-6">Celovit letni ROI</h2>
            
            <div class="space-y-6">
              <!-- A. PRIHODKI -->
              <div>
                <h3 class="text-sm font-bold text-green-400 uppercase tracking-wider mb-3 border-b border-slate-700 pb-2">A. Povečani Prihodki</h3>
                <div class="space-y-3 text-sm">
                  <div class="flex justify-between">
                    <span class="text-slate-400">Povrnjeni izgubljeni leadi (hitrost)</span>
                    <span id="rev-leads" class="font-bold text-green-400">0 €</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-slate-400">Referali in stiki (zadovoljstvo)</span>
                    <span id="rev-referrals" class="font-bold text-green-400">0 €</span>
                  </div>
                  <div class="flex justify-between pt-2 border-t border-slate-800">
                    <span class="text-slate-300 font-medium">Skupni novi prihodki</span>
                    <span id="rev-total" class="font-extrabold text-white">0 €</span>
                  </div>
                </div>
              </div>

              <!-- B. STROŠKI -->
              <div>
                <h3 class="text-sm font-bold text-blue-400 uppercase tracking-wider mb-3 border-b border-slate-700 pb-2">B. Zmanjšani Stroški</h3>
                <div class="space-y-3 text-sm">
                  <div class="flex justify-between">
                    <span class="text-slate-400">Konsolidacija orodij (SaaS)</span>
                    <span id="sav-tools" class="font-bold text-blue-400">0 €</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-slate-400">Prihranjen čas (avtomatizacija)</span>
                    <span id="sav-time" class="font-bold text-blue-400">0 €</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-slate-400">Manj napak & bolniški (uptime)</span>
                    <span id="sav-errors" class="font-bold text-blue-400">0 €</span>
                  </div>
                  <div class="flex justify-between pt-2 border-t border-slate-800">
                    <span class="text-slate-300 font-medium">Skupni prihranki</span>
                    <span id="sav-total" class="font-extrabold text-white">0 €</span>
                  </div>
                </div>
              </div>

              <!-- C. KONČNI ROI -->
              <div class="bg-slate-800 p-4 rounded-lg">
                <div class="flex justify-between text-sm mb-2">
                  <span class="text-slate-400">Letni strošek AI sistema</span>
                  <span class="font-bold text-red-400">- 12.000 €</span>
                </div>
                <div class="flex justify-between text-lg mb-4 pb-4 border-b border-slate-700">
                  <span class="text-slate-300 font-medium">Skupni letni povratek</span>
                  <span id="total-return" class="font-extrabold text-white">0 €</span>
                </div>
                
                <p class="text-sm text-green-300 text-center mb-1">Neto dobiček (Profit)</p>
                <p id="net-profit" class="text-3xl font-extrabold text-white text-center mb-4">0 €</p>
                
                <p class="text-sm text-green-300 text-center mb-1">ROI (Return on Investment)</p>
                <p id="roi-percentage" class="text-5xl font-extrabold text-green-400 text-center">0 %</p>
              </div>
            </div>
            <p class="mt-4 text-xs text-slate-500">* Izračun upošteva stroške orodij, delovni čas, napake in nove prihodke.</p>
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>

<style>
  .btn-primary { @apply inline-flex items-center justify-center gap-2 rounded-md bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 transition-colors duration-200; }
  .btn-secondary { @apply inline-flex items-center justify-center gap-2 rounded-md bg-gray-200 dark:bg-slate-700 px-6 py-3 text-sm font-semibold text-gray-900 dark:text-white shadow-sm hover:bg-gray-300 dark:hover:bg-slate-600 transition-colors duration-200; }
</style>

<script is:inline>
  // ZAGOTOVIMO, DA SE SKRIPTA IZVEDE ŠELE, KO JE STRAN NALOŽENA
  document.addEventListener('DOMContentLoaded', function() {
    
    // --- LOGIKA ČAROVNIKA ---
    const form = document.getElementById('multi-step-form');
    const steps = document.querySelectorAll('.form-step');
    const progressBars = document.getElementById('progress-bar');
    const stepText = document.getElementById('step-text');
    const stepPercent = document.getElementById('step-percent');
    let currentStep = 1;
    const totalSteps = steps.length;

    function updateUI() {
      steps.forEach(step => {
        if (parseInt(step.dataset.step) === currentStep) step.classList.remove('hidden');
        else step.classList.add('hidden');
      });
      const percent = Math.round((currentStep / totalSteps) * 100);
      progressBars.style.width = percent + '%';
      stepText.textContent = `Korak ${currentStep} od ${totalSteps}`;
      stepPercent.textContent = percent + '%';
    }

    document.querySelectorAll('.next-btn').forEach(button => {
      button.addEventListener('click', () => {
        const currentStepElement = document.querySelector(`.form-step[data-step="${currentStep}"]`);
        const requiredInputs = currentStepElement.querySelectorAll('[required]');
        let isValid = true;
        requiredInputs.forEach(input => {
          if (!input.value) {
            isValid = false;
            input.classList.add('ring-red-500');
            input.reportValidity();
          } else {
            input.classList.remove('ring-red-500');
          }
        });
        if (isValid && currentStep < totalSteps) {
          currentStep++;
          updateUI();
          window.scrollTo({ top: form.offsetTop - 100, behavior: 'smooth' });
        }
      });
    });

    document.querySelectorAll('.prev-btn').forEach(button => {
      button.addEventListener('click', () => {
        if (currentStep > 1) {
          currentStep--;
          updateUI();
          window.scrollTo({ top: form.offsetTop - 100, behavior: 'smooth' });
        }
      });
    });

    // --- CELI ROI MODEL ---
    const leadsInput = document.getElementById('leads');
    const responseTimeInput = document.getElementById('response_time');
    const valueInput = document.getElementById('value');
    const existingCustomersInput = document.getElementById('existing_customers');
    const toolCostInput = document.getElementById('tool_cost');
    const manualWorkInput = document.getElementById('manual_work');

    const revLeadsEl = document.getElementById('rev-leads');
    const revReferralsEl = document.getElementById('rev-referrals');
    const revTotalEl = document.getElementById('rev-total');
    const savToolsEl = document.getElementById('sav-tools');
    const savTimeEl = document.getElementById('sav-time');
    const savErrorsEl = document.getElementById('sav-errors');
    const savTotalEl = document.getElementById('sav-total');
    const totalReturnEl = document.getElementById('total-return');
    const netProfitEl = document.getElementById('net-profit');
    const roiPercentageEl = document.getElementById('roi-percentage');

    const SYSTEM_ANNUAL_COST = 12000;
    const HOURLY_RATE = 25;

    function formatCurrency(num) {
      return new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(num);
    }

    function calculateROI() {
      const leads = parseFloat(leadsInput.value) || 0;
      const responseTime = parseFloat(responseTimeInput.value) || 0;
      const value = parseFloat(valueInput.value) || 0;
      const existingCusts = parseFloat(existingCustomersInput.value) || 0;
      const toolCost = parseFloat(toolCostInput.value) || 0;
      const manualHours = parseFloat(manualWorkInput.value) || 0;

      // A. PRIHODKI
      let lossRate = 0;
      if (responseTime > 1) lossRate = Math.min(0.8, (responseTime - 1) * 0.15);
      const annualRecoveredRev = (leads * lossRate) * 12 * value;
      const annualReferralRev = existingCusts * 0.1 * value * 2; 
      const totalRev = annualRecoveredRev + annualReferralRev;

      // B. STROŠKI
      const annualToolSavings = toolCost * 12 * 0.80;
      const annualTimeSavings = ((manualHours * 0.8 * 250) + (leads * 12 * (5 / 60))) * HOURLY_RATE;
      const annualErrorSavings = (leads * 12 * value * 0.02) + 1000;
      const totalSav = annualToolSavings + annualTimeSavings + annualErrorSavings;

      // C. SKUPNO
      const totalReturn = totalRev + totalSav;
      const netProfit = totalReturn - SYSTEM_ANNUAL_COST;
      const roiPercentage = SYSTEM_ANNUAL_COST > 0 ? Math.round((netProfit / SYSTEM_ANNUAL_COST) * 100) : 0;

      // POSODOBITEV DOM
      revLeadsEl.textContent = formatCurrency(annualRecoveredRev);
      revReferralsEl.textContent = formatCurrency(annualReferralRev);
      revTotalEl.textContent = formatCurrency(totalRev);

      savToolsEl.textContent = formatCurrency(annualToolSavings);
      savTimeEl.textContent = formatCurrency(annualTimeSavings);
      savErrorsEl.textContent = formatCurrency(annualErrorSavings);
      savTotalEl.textContent = formatCurrency(totalSav);

      totalReturnEl.textContent = formatCurrency(totalReturn);
      netProfitEl.textContent = formatCurrency(netProfit);
      roiPercentageEl.textContent = roiPercentage + ' %';
      
      roiPercentageEl.className = roiPercentage >= 100 
        ? 'text-5xl font-extrabold text-green-400 text-center' 
        : 'text-5xl font-extrabold text-yellow-400 text-center';
    }

    // PRIPRAVI EVENT LISTENERJE NA VSE VNOSE ZA LIVE POSODOBITEV
    const roiInputs = document.querySelectorAll('.roi-input');
    roiInputs.forEach(input => {
      input.addEventListener('input', calculateROI);
      input.addEventListener('change', calculateROI);
    });

    // POŽENI IZRAČUN OB NALAGANJU
    calculateROI(); 

    // --- WEBHOOK SUBMIT ---
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector('button[type="submit"]');
      submitBtn.disabled = true;
      submitBtn.innerText = 'Generiram poročilo...';

      const formData = new FormData(form);
      const payload = Object.fromEntries(formData);
      
      payload.Izracun_ROI = {
        prihodki: {
          povrnjeni_leadi: revLeadsEl.innerText,
          referali: revReferralsEl.innerText,
          skupno: revTotalEl.innerText
        },
        prihranki: {
          orodja: savToolsEl.innerText,
          cas: savTimeEl.innerText,
          napake_bolniske: savErrorsEl.innerText,
          skupno: savTotalEl.innerText
        },
        letni_strosek_sistema: SYSTEM_ANNUAL_COST + ' €',
        skupni_povratek: totalReturnEl.innerText,
        neto_dobicek: netProfitEl.innerText,
        roi_procent: roiPercentageEl.innerText
      };

      try {
        // TUKAJ VNESI SVOJ WEBHOOK URL
        const response = await fetch('TVOJ_WEBHOOK_URL', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (response.ok) {
          alert('Hvala! PDF s celovito analizo vam bomo poslali na e-mail.');
          form.reset();
          currentStep = 1;
          updateUI();
          calculateROI();
        } else {
          alert('Napaka pri pošiljanju.');
        }
      } catch (error) {
        alert('Napaka povezave.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerText = 'Generiraj PDF poročilo';
      }
    });
  });
</script>
