---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'AstroWind — Brezplačna predloga za izdelavo spletnih strani z Astro + Tailwind CSS',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Prenesi predlogo',
        href: 'https://github.com/arthelokyo/astrowind',
        target: '_blank',
        icon: 'tabler:download',
      },
      { text: 'Izvej več', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'AstroWind naslovna slika' }}
  >
    <Fragment slot="title">
      Brezplačna predloga za <span class="hidden xl:inline">izdelavo spletnih strani z</span>
      <span class="text-accent dark:text-white"> Astro v7</span> + Tailwind CSS
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">AstroWind</span> je brezplačna, prilagodljiva in za produkcijo pripravljena predloga za Astro v7 +
        Tailwind CSS v4.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">AstroWind: Pripravljeno za produkcijo.</span>
      Primerno za startup podjetja, mala podjetja, SaaS spletne strani, profesionalne portfelje, tržne spletne strani, ciljne strani in bloga.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note title="Filozofija:" description="Preprostost, najboljše prakse in visoka zmogljivost" />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Zmogljivosti"
    title="Kaj dobite z AstroWind"
    subtitle="Ena najbolj profesionalnih in celovitih predlog na trgu. Najboljša ocenjena in forkana Astro tema v letih 2022, 2023, 2024 in 2025."
    items={[
      {
        title: 'Integracija Astro + Tailwind CSS',
        description:
          'Brezhibna integracija med odličnima ogrodjema, ki ponujata visoko produktivnost, zmogljivost in prilagodljivost. Zdaj poganja Tailwind CSS v4.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'Pripravljeni za uporabo komponente',
        description:
          'Gradniki, izdelani s Tailwind CSS v4, pripravljeni za uporabo na tržnih spletnih straneh, SaaS, blogih, osebnih profilih, malih podjetjih...',
        icon: 'tabler:components',
      },
      {
        title: 'Najboljše prakse',
        description:
          'Ustvarjanje varnih, učinkovitih in uporabniku prijaznih spletnih strani, ki nudijo izjemne izkušnje in trajno vrednost.',
        icon: 'tabler:list-check',
      },
      {
        title: 'Odlična hitrost strani',
        description:
          'Dobra hitrost strani vpliva na organsko uvrščanje v iskalnikih, izboljšuje uporabniško izkušnjo (UI/UX) in povečuje stopnje konverzij.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Optimizacija za iskalnike (SEO)',
        description:
          'SEO izboljšuje vidnost spletne strani, povečuje organski promet in omogoča doseg širše publike.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'Odprti za nove ideje in prispevke',
        description:
          'Sprejemanje kulture, odprte za nove ideje in prispevke, spodbuja inovacije, sodelovanje in dinamično uporabniško izkušnjo.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="Znotraj predloge"
    title="Načrt AstroWind: Zabava sreča funkcionalnost!"
    items={[
      {
        title: 'Zgrajeno na Astro v7',
        description:
          'Izkoristite zmogljivost in razvijalcem prijazne funkcije tega modernega generatorja statičnih strani.',
      },
      {
        title: 'Oblikovano s Tailwind CSS v4',
        description:
          'Omogoča hitro oblikovanje in dosleden stil s tem priljubljenim CSS ogrodjem, ki temelji na pripomočkih (utility-first).',
      },
      {
        title: 'Združljivost med brskalniki',
        description:
          'Zagotavlja, da vaša stran izgleda in deluje enako v različnih brskalnikih ter vsem uporabnikom ponuja brezhibno izkušnjo.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Barvita slika',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Gradnja na modernih temeljih</h3>
      Pridobite konkurenčno prednost z vključevanjem vodilnih industrijskih praks
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Visoka raven prilagodljivosti',
        description: `Brez težav prilagodite predlogo identiteti in zahtevam svoje blagovne znamke, da bo vaša spletna stran edinstvena, pri čemer prihranite čas.`,
      },
      {
        title: 'Različne možnosti postavitve',
        description:
          'Raziščite različne možnosti postavitve, da najdete strukturo, ki najbolje predstavi vašo vsebino in izboljša navigacijo.',
      },
      {
        title: 'Polno odziven dizajn',
        description:
          "Zagotavlja optimalno delovanje vaše strani na različnih napravah in zaslonih za dosledno in prijetno uporabniško izkušnjo.",
      },
      {
        title: 'Integracija medijev',
        description:
          'Brezhibno vključite slike, videoposnetke in multimedijske elemente, ki obogatijo vašo vsebino in privlačijo obiskovalce.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
      alt: 'Slika načrta',
    }}
  >
    <Fragment slot="content">Zagotovite, da vas spletna prisotnost resnično predstavlja.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Izboljšano privabljanje uporabnikov',
        description:
          'Očarajte občinstvo z interaktivnimi elementi, intuitivno navigacijo in vizualno privlačnimi postavitvami, ki spodbujajo daljše obiske.',
      },
      {
        title: 'Nenehne izboljšave',
        description:
          'Zagotovite, da bo vaša spletna stran s rednimi posodobitvami vedno v skladu z najnovejšimi trendi in tehnologijami.',
      },
      {
        title: 'Časovna in viru učinkovitost',
        description:
          'Preskočite časovno potratno gradnjo strani od začetka in svojo prisotnost na spletu vzpostavite prej z AstroWind.',
      },
      {
        title: 'Podpora skupnosti',
        description: `Pridružite se rastoči skupnosti AstroWind za vpoglede, vire in pomoč, da na poti razvoja spletnih strani ne boste nikoli sami.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Slika astronavtov',
    }}
  >
    <Fragment slot="content">Oblikovano za spodbujanje rasti in uspeha.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="S svojo sanjsko spletno stranjo začnite v trenutku z AstroWind."
    items={[
      {
        title: 'Korak 1: <span class="font-medium">Prenesi</span>',
        description:
          "Začnite z GitHub! Ali forknite predlogo AstroWind ali preprosto kliknite 'Uporabi to predlogo'. Vaše platno čaka na vaš digitalni mojstrovni del. V samo nekaj klikih ste postavili temelje.",
        icon: 'tabler:package',
      },
      {
        title: 'Korak 2: <span class="font-medium">Dodaj vsebino</span>',
        description:
          "Vlijte v to svojo vizijo. Dodajte slike, besedila in vse ostalo, kar bo oživilo vaš digitalni prostor. Ne pozabite, da je vsebina tista, ki pripoveduje vašo zgodbo, zato jo naredite privlačno.",
        icon: 'tabler:letter-case',
      },
      {
        title: 'Korak 3: <span class="font-medium">Prilagodi stile</span>',
        description:
          'Dodajte svoj osebni pridih. Prilagodite barve, pisave in postavitve, dokler ni prav. Vaš edinstven pridih, ojačan z AstroWind! Natančnost v oblikovanju zagotavlja brezhibno uporabniško izkušnjo.',
        icon: 'tabler:paint',
      },
      {
        title: 'Pripravljeno!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Slika korakov',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Najpogosteje uporabljeni gradniki"
    subtitle="Ponuja pogosto uporabljene komponente za izgradnjo spletnih strani s Tailwind CSS v4"
    tagline="Komponente"
    items={[
      {
        title: 'Glave (Headers)',
        description: "Ste že kdaj poskušali voziti brez navigacije? Zato spletne strani potrebujejo glave za smer.",
        icon: 'flat-color-icons:template',
      },
      {
        title: 'Heroji (Heros)',
        description:
          "Predstavljajte si pristanek superjunaka – epsko, a ne? To je naloga oddelka Hero, ki omogoča veličastne vnose!",
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'Funkcije (Features)',
        description:
          'Kjer spletne strani ponosno razkazujejo svoje moči. Tukaj primanjkuje le razmetavanja!',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'Vsebina (Content)',
        description:
          "Potopite se v meso in krompir strani; brez tega bi le opazovali izložbe. Vsebina je kralj.",
        icon: 'flat-color-icons:document',
      },
      {
        title: 'Klic k dejanju (Call-to-Action)',
        description:
          'Tisti navdušeni prijatelj, ki vedno priga: "Daj! Daj!". Ja, to je ta gumb, ki vas brca v dogodivščino.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'Cenik (Pricing)',
        description: 'Poglejte jedilni list spletne strani. Mamljive izbire čakajo, ali lahko odolhite?',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'Pričevanja (Testimonial)',
        description: 'Stopite v kot za klepet! Tukaj obiskovalci razkrivajo skrivnosti in delijo sočne podrobnosti.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'Kontakt (Contact)',
        description:
          'Kot digitalen poštni predal, samo hitrejši! Spustite vrstico, zastavite vprašanje ali pošljite virtualni pet. Ding! Sporočilo je notri.',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'Noge (Footers)',
        description: "Noga je kot zaključni napisi filma, vendar posuta z velikonočnimi jajci. Čas za iskanje!",
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="Izvejte več vsebine v našem Blogu"
    information={`Blog se uporablja za prikaz dokumentacije AstroWind.
                        Vsak nov članek bo pomemben korak, ki ga boste morali poznati, da postanete strokovnjak za izdelavo spletne strani z Astro v7 + Tailwind CSS v4.
                        Astro je zelo zanimiva tehnologija. Hvala.
                `}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Pogosto zastavljena vprašanja"
    subtitle="Potopite se v naslednja vprašanja, da pridobite vpogled v zmogljive funkcije, ki jih ponuja AstroWind in kako lahko izboljša vaše potovanje v spletnem razvoju."
    tagline="PZV"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'Zakaj AstroWind?',
        description:
          "Michael Knight, mladi samotar na pohodu za obrambo nedolžnih. Nemočnih. Tistih brez moči v svetu kriminalcev, ki delujejo nad zakonom. Tukaj prihaja. Tukaj prihaja Speed Racer. Je demon na kolesih.",
      },
      {
        title: 'Kaj potrebujem za začetek?',
        description:
          'Vesolje, zadnja meja. To so potovanja zvezdne ladje Enterprise. Njena petletna naloga: raziskovanje čudovitih novih svetov. Mnogi pravijo, da je raziskovanje del našega usoda, a v resnici je to naša dolžnost do prihodnjih generacij.',
      },
      {
        title: 'Kako namestiti predlogo Astro + Tailwind CSS?',
        description:
          "No, tako kot delajo oddaje je, da naredijo eno. To se imenuje pilot. Nato jo pokažejo ljudem, ki delajo oddaje in na podlagi te ene odločijo, ali bodo naredili več.",
      },
      {
        title: "Kaj je nekaj, česar ne razumete?",
        description:
          "Cvet v mojem vrtu, skrivnost v mojih hlačkah. Infarkt ni ustavil starega Velikega Medveda. Niti nisem vedel, da ga imenujemo Veliki Medved.",
      },
      {
        title: 'Kaj bi radi ponovno poskusili?',
        description:
          "Posel dovolj velik, da bi bil na NASDAQ, gre v stečaj. Izgine! Preneha obstajati brez mene. Ne, očitno ne veste, s kom govorite, zato vam bom dal namig.",
      },
      {
        title: 'Če bi lahko vsaki osebi, ki jo srečate, postavili le eno vprašanje, kaj bi to bilo?',
        description:
          "To ni o maščevanju. Gre za pravičnost. Veliko stvari se lahko spremeni v dvanajstih letih, Admiral. No, to je zagotovo dobro vedeti. Približno štiri leta. Sem se naveličal slišati, kako mlad izgledam.",
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Prenosi', amount: '132K' },
      { title: 'Zvezdice', amount: '24.8K' },
      { title: 'Forki', amount: '10.3K' },
      { title: 'Uporabniki', amount: '48.4K' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Prenesi predlogo',
        href: 'https://github.com/arthelokyo/astrowind',
        target: '_blank',
        icon: 'tabler:download',
      },
    ]}
  >
    <Fragment slot="title">
      Astro&nbsp;+&nbsp;<br class="block sm:hidden" /><span class="sm:whitespace-nowrap">Tailwind CSS</span>
    </Fragment>

    <Fragment slot="subtitle">
      Bodite zelo presenečeni nad ogromnimi lažnimi številkami, ki jih vidite na tej strani. <br class="hidden md:inline" />Ne zapravljajte več časa! :P
    </Fragment>
  </CallToAction>
</Layout>
